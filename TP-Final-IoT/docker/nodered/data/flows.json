    {
        "id": "ee22b75d8956fd16",
        "type": "function",
        "z": "12e532b125237eb5",
        "name": "function 1",
        "func": "// 1. Convertimos el texto JSON que viene de la web a un objeto de JavaScript\ntry {\n    let datos = JSON.parse(msg.payload);\n    \n    // 2. Evaluamos el estado de la propiedad 'bomba'\n    if (datos.bomba === true) {\n        msg.payload = \"ON\";\n    } else if (datos.bomba === false) {\n        msg.payload = \"OFF\";\n    } else {\n        return null; // Si no trae la propiedad 'bomba', descartamos el mensaje\n    }\n    \n    // 3. Le definimos el topic de MQTT directamente aquí (opcional pero recomendado)\n    msg.topic = \"nodo0/valvula\";\n    \n    return msg;\n    \n} catch(e) {\n    // Por si acaso llega un texto que no sea JSON válido\n    node.error(\"Error al procesar el JSON de la web: \" + e.message);\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 480,
        "wires": [
